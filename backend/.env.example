# Provider LLM: "gemini" (default) oppure "ollama" (offline mode)
LLM_PROVIDER=gemini
# Ottieni la chiave su https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Solo per offline mode:
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Provider OpenAI-compatible (LM Studio, vLLM, LocalAI, Ollama su /v1)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_MODEL=qwen3.5-9b
# OPENAI_API_KEY=
